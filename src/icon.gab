// icon: draws the CodeBridge icon (a blue rounded square with four white dots, "a code") into a
// premultiplied BGRA pixel buffer, 4x4 supersampled, with integer arithmetic only.

// is the sub-sample (x, y) of a `s` by `s` grid inside a rounded square with corner radius `r`?
inside_round :: fn(x: i32, y: i32, s: i32, r: i32) -> bool {
    ax := x; if s - 1 - x < ax { ax = s - 1 - x; }
    ay := y; if s - 1 - y < ay { ay = s - 1 - y; }
    if ax >= r || ay >= r { return true; }
    dx := r - ax;
    dy := r - ay;
    return dx * dx + dy * dy <= r * r;
}

in_dots :: fn(x: i32, y: i32, s: i32) -> bool {
    rad := s * 6 / 100;
    cy := s / 2;
    k := 1;
    while k <= 4 {
        cx := s * (2 * k) / 10;
        dx := x - cx;
        dy := y - cy;
        if dx * dx + dy * dy <= rad * rad { return true; }
        k += 1;
    }
    return false;
}

// `out` holds size * size pixels (row by row), each a u32 as 0xAARRGGBB
pub render_icon :: fn(size: i32, out: []u32) {
    ss := 4;
    big := size * ss;
    r := big * 22 / 100;
    y := 0;
    while y < size {
        // vertical gradient from (96,165,250) to (37,99,235)
        br := 96 + (37 - 96) * y / size;
        bg := 165 + (99 - 165) * y / size;
        bb := 250 + (235 - 250) * y / size;
        x := 0;
        while x < size {
            cov := 0;
            dots := 0;
            sy := 0;
            while sy < ss {
                sx := 0;
                while sx < ss {
                    px := x * ss + sx;
                    py := y * ss + sy;
                    if inside_round(px, py, big, r) {
                        cov += 1;
                        if in_dots(px, py, big) { dots += 1; }
                    }
                    sx += 1;
                }
                sy += 1;
            }
            idx := (y * size + x) as usize;
            if cov == 0 {
                out[idx] = 0u32;
            } else {
                cr := (br * (cov - dots) + 255 * dots) / cov;
                cg := (bg * (cov - dots) + 255 * dots) / cov;
                cb := (bb * (cov - dots) + 255 * dots) / cov;
                a := cov * 255 / (ss * ss);
                pr := cr * a / 255;
                pg := cg * a / 255;
                pb := cb * a / 255;
                out[idx] = ((a as u32) << 24u32) | ((pr as u32) << 16u32) | ((pg as u32) << 8u32) | (pb as u32);
            }
            x += 1;
        }
        y += 1;
    }
}

// The pixels for the small icon sizes (up to 32) are worked out by the compiler (#run) and stored in the
// program as plain data, so nothing is drawn at startup. The array length is part of the type, so each
// size has its own function.
table16 :: fn() -> [256]u32 { t: [256]u32 = .{}; render_icon(16, t[:]); return t; }
table24 :: fn() -> [576]u32 { t: [576]u32 = .{}; render_icon(24, t[:]); return t; }
table32 :: fn() -> [1024]u32 { t: [1024]u32 = .{}; render_icon(32, t[:]); return t; }

ICON16: [256]u32 = #run table16();
ICON24: [576]u32 = #run table24();
ICON32: [1024]u32 = #run table32();

copy_pixels :: fn(src: []const u32, out: []u32) {
    i: usize = 0usize;
    while i < src.len { out[i] = src[i]; i += 1usize; }
}

// Copies the stored icon that is at least `size` pixels wide into `out` and returns its size.
// For anything larger than 32 it returns 0, and the caller draws the icon itself with render_icon:
// the compile-time interpreter is slow on big arrays (a 48 pixel table added 8 seconds to every build, a 96 pixel one a minute).
pub icon_pixels :: fn(size: i32, out: []u32) -> i32 {
    if size <= 16 { copy_pixels(ICON16[0..], out); return 16; }
    if size <= 24 { copy_pixels(ICON24[0..], out); return 24; }
    if size <= 32 { copy_pixels(ICON32[0..], out); return 32; }
    return 0;
}
